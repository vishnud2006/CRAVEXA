# CRAVEXA Backend Environment Configuration (Example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and fill in real values for your environment.

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:8000

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cravexa
# For SQLite local fallback / testing:
# DATABASE_URL=sqlite+aiosqlite:///./cravexa_dev.db

# JWT Security
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Bootstrap (CRAVEXA Root Admin)
ADMIN_EMAIL=cravexa10@gmail.com
ADMIN_INITIAL_PASSWORD=ChangeMeImmediately123!

# Firebase Authentication (Server-Side Verification)
FIREBASE_PROJECT_ID=cravexa-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@cravexa-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Razorpay Payment Gateway (Phase 8 - Future Integration)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key

# Cloudinary Media Storage (Future Integration)
CLOUDINARY_CLOUD_NAME=cravexa-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=placeholder_cloudinary_api_secret
